rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Codenames are public to every agent (used in the assignee dropdown).
    // Each agent can only write their own profile.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Heists are visible to every signed-in agent (the expired list spans all
    // users). Only the creator can create one, and only in their own name.
    match /heists/{heistId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }
  }
}
